body{
font-family: 'Inter', sans-serif;
margin:0;
background:#f7f7f7;
color:#333;
}

nav{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 40px;
background:#0B3D2E;
color:white;
position:sticky;
top:0;
}

.logo{
font-weight:600;
font-size:20px;
}

.nav-links a{
margin-left:20px;
color:white;
text-decoration:none;
}

.nav-cta{
background:#B08A2E;
padding:8px 16px;
border-radius:5px;
}

.hero{
background:#0B3D2E;
color:white;
text-align:center;
padding:140px 20px;
}

.hero h1{
font-family:'Playfair Display';
font-size:48px;
}

.hero p{
max-width:600px;
margin:auto;
margin-top:20px;
}

.cta{
display:inline-block;
margin-top:30px;
background:#B08A2E;
padding:14px 28px;
border-radius:6px;
color:white;
text-decoration:none;
font-weight:600;
}

.section{
padding:80px 20px;
text-align:center;
}

.dark{
background:#0B3D2E;
color:white;
}

.cards{
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:30px;
margin-top:40px;
}

.card{
background:white;
padding:30px;
border-radius:10px;
width:260px;
box-shadow:0 10px 20px rgba(0,0,0,0.1);
transition:.3s;
}

.card:hover{
transform:translateY(-6px);
}

.dark .card{
color:#333;
}

.contact form{
max-width:600px;
margin:auto;
display:flex;
flex-direction:column;
gap:14px;
}

input,select,textarea{
padding:12px;
border-radius:6px;
border:1px solid #ddd;
}

button{
background:#B08A2E;
color:white;
border:none;
padding:14px;
border-radius:6px;
font-size:16px;
cursor:pointer;
}

footer{
background:#0B3D2E;
color:white;
text-align:center;
padding:40px;
}

.social a{
margin:0 10px;
color:#B08A2E;
text-decoration:none;
}


document.querySelectorAll('a[href^="#"]').forEach(anchor => {
